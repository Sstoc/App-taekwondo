{
  "rewrites": [
    {
      "source": "/.netlify/functions/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/((?!api/|assets/|manifest\\.json|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|.*\\.(?:png|jpg|jpeg|svg|ico|css|js)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(manifest\\.json|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
